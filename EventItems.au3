#include-once
; Explicit festival-item whitelist. Emblems and lockpicks retain separate toggles.
Global Const $BB_FestivalDrops[] = [ _
    $GC_I_MODELID_GOLDEN_EGG, $GC_I_MODELID_CHOCOLATE_BUNNY, _
    $GC_I_MODELID_CUPCAKE, $GC_I_MODELID_FOUR_LEAF_CLOVER, $GC_I_MODELID_SHAMROCK_ALE, _
    $GC_I_MODELID_BOTTLE_OF_GROG, $GC_I_MODELID_HUNTERS_ALE, $GC_I_MODELID_AGED_HUNTERS_ALE, _
    $GC_I_MODELID_PUMPKIN_PIE, $GC_I_MODELID_PUMPKIN_COOKIE, _
    $GC_I_MODELID_CANDY_CORN, $GC_I_MODELID_CANDY_APPLE, _
    $GC_I_MODELID_HARD_APPLE_CIDER, $GC_I_MODELID_WITCHS_BREW, $GC_I_MODELID_VIAL_OF_ABSINTHE, _
    $GC_I_MODELID_GHOST_IN_THE_BOX, $GC_I_MODELID_SQUASH_SERUM, _
    $GC_I_MODELID_TRANSMOGRIFIER_TONIC, $GC_I_MODELID_SPOOKY_TONIC, $GC_I_MODELID_MINUTELY_MAD_KING_TONIC, _
    $GC_I_MODELID_EGGNOG, $GC_I_MODELID_SPIKED_EGGNOG, $GC_I_MODELID_FRUITCAKE, _
    $GC_I_MODELID_SNOWMAN_SUMMONER, $GC_I_MODELID_PEPPERMINT_CC, _
    $GC_I_MODELID_WINTERGREEN_CC, $GC_I_MODELID_RAINBOW_CC, $GC_I_MODELID_YULETIDE_TONIC, _
    $GC_I_MODELID_BOTTLE_ROCKET, $GC_I_MODELID_CHAMPAGNE_POPPER, $GC_I_MODELID_SPARKLER, _
    $GC_I_MODELID_SUGARY_BLUE_DRINK, $GC_I_MODELID_RED_BEAN_CAKE, $GC_I_MODELID_CREME_BRULEE, _
    $GC_I_MODELID_KRYTAN_BRANDY, $GC_I_MODELID_KRYTAN_LOKUM, _
    $GC_I_MODELID_BATTLE_ISLE_ICED_TEA, $GC_I_MODELID_DELICIOUS_CAKE, $GC_I_MODELID_PARTY_BEACON, _
    $GC_I_MODELID_HONEYCOMB _
]
Func BB_IsEventItem($model)
    ; The API event array contains model IDs directly, without a count prefix.
    For $i=0 To UBound($GC_AI_EVENT_ITEMS)-1
        If $model=$GC_AI_EVENT_ITEMS[$i] Then Return True
    Next
    For $i=0 To UBound($BB_FestivalDrops)-1
        If $model=$BB_FestivalDrops[$i] Then Return True
    Next
    Return False
EndFunc
